<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource color.bg.canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyPrimary}" />
    </Style>

    <Style Selector="TextBox.TextArea">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="96" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="TextBlock.pane-label">
        <Setter Property="Margin" Value="12,4,12,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LetterSpacing" Value="0.2" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LetterSpacing" Value="-0.2" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.surface-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>

    <Style Selector="Border.plain-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,14" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="Border.plain-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Border.hairline">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,18" />
        <Setter Property="Background" Value="{DynamicResource MyOutline}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.node-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource radius.md}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.node-accent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.node-card TextBlock.card-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <Style Selector="Border.node-card TextBlock.card-delay">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Border.node-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.node-card.active">
        <Setter Property="Background" Value="{DynamicResource color.bg.surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.node-card.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource color.bg.surface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.node-card.active Border.node-accent">
        <Setter Property="Background" Value="{DynamicResource color.accent}" />
    </Style>

    <Style Selector="Button.connect">
        <Setter Property="Background" Value="{DynamicResource color.bg.inverse}" />
        <Setter Property="Foreground" Value="{DynamicResource color.fg.inverse}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource radius.lg}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MaxHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Button.connect TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.connect:pointerover">
        <Setter Property="Background" Value="{DynamicResource color.bg.inverse.hover}" />
        <Setter Property="Foreground" Value="{DynamicResource color.fg.inverse}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.connect.connected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.connect.connected:pointerover">
        <Setter Property="Background" Value="{DynamicResource color.bg.surfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.connect.connected:pressed">
        <Setter Property="Background" Value="{DynamicResource color.bg.selected}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.tonal">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.tonal:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.outline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button.outline:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button.theme-toggle">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.theme-toggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.footer-icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.footer-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseFloatingPlaceholder" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
    </Style>

    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyPrimary}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource color.bg.elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource radius.lg}" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Margin" Value="14" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="MenuFlyoutPresenter /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource color.bg.elevated}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="BoxShadow" Value="0 12 32 0 #332A2824" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2,1" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:checked /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:checked:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="MenuFlyoutPresenter MenuItem:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="MenuFlyoutPresenter Separator">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="8" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Border
                        Classes="nav-mark"
                        Width="3"
                        Height="20"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <Style Selector="RadioButton.nav:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="RadioButton.nav:checked /template/ Border.nav-mark">
        <Setter Property="Background" Value="{DynamicResource color.accent}" />
    </Style>

    <Style Selector="TextBlock.nav-label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton.nav:checked TextBlock.nav-label">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <Style Selector="TextBlock.nav-section">
        <Setter Property="Margin" Value="22,14,12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.drawer-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.drawer-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.drawer-action.compact">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="4,1" />
    </Style>

    <Style Selector="Button.drawer-action TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Theme" Value="{StaticResource SoftScrollBar}" />
    </Style>

    <Style Selector="Border.soft-pane">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4,0,8" />
    </Style>

    <Style Selector="Button.soft-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.soft-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.soft-item:pressed">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource MyKbd}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="TextBlock.kbd">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Border.badge-protocol">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.badge-delay">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.version-chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.version-chip TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
    </Style>

    <Style Selector="ListBox.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ListBox.nodes">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.nodes ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MaxHeight" Value="52" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource color.bg.surfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource color.bg.surfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.accent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="Transparent" />
