<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource MySurface}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="TextBox.TextArea">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="96" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="TextBlock.pane-label">
        <Setter Property="Margin" Value="12,4,12,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LetterSpacing" Value="0.2" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LetterSpacing" Value="-0.2" />
    </Style>

    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.surface-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BoxShadow" Value="0 0 0 0" />
    </Style>

    <Style Selector="Border.plain-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,14" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="Border.plain-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Border.hairline">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,18" />
        <Setter Property="Background" Value="{DynamicResource MyOutline}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.node-card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,14" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <Style Selector="Border.node-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Border.node-card.active">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.node-card.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="Button.connect">
        <Setter Property="Background" Value="{DynamicResource MyInk}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnInk}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.connect:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyInkHover}" />
    </Style>

    <Style Selector="Button.tonal">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.tonal:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.outline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button.outline:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button.theme-toggle">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.theme-toggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseFloatingPlaceholder" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
    </Style>

    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyPrimary}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6,8" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="RadioButton.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="RadioButton.nav:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="TextBlock.nav-label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton.nav:checked TextBlock.nav-label">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.nav-section">
        <Setter Property="Margin" Value="22,14,12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.drawer-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.drawer-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.drawer-action TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ScrollViewer.soft">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <Style Selector="ScrollViewer.soft /template/ ScrollBar RepeatButton#PART_LineUpButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ScrollViewer.soft /template/ ScrollBar RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Border.soft-pane">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4,0,8" />
    </Style>

    <Style Selector="Button.soft-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.soft-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Button.soft-item:pressed">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource MyKbd}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="TextBlock.kbd">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Border.badge-protocol">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.badge-delay">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.version-chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.version-chip TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="ListBox.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MaxHeight" Value="52" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Button.chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button.chip-proxy">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.chip-proxy.on">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button.chip-direct">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.chip-direct.on">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button.chip-block">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.chip-block.on">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="ToggleButton.segment">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ToggleButton.segment:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="ToggleButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Border.segment-track">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="RadioButton.mode">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.mode:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="RadioButton.mode:checked">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="Button.settings-row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="8,14" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="Button.settings-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="48" />
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridCell:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="DataGridCell:selected">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="DataGridCell:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource MySelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="Background" Value="{DynamicResource MyHover}" />
    </Style>

    <Style Selector="Label.Solid.Red">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipRedText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
</Styles>
