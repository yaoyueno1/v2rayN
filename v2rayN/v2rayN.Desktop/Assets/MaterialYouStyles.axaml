<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource MySurface}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style Selector="Border.surface-card">
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #14000000" />
    </Style>

    <Style Selector="Border.node-card">
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BoxShadow" Value="0 1 1 0 #10000000" />
    </Style>

    <Style Selector="Border.node-card.active">
        <Setter Property="Background" Value="{DynamicResource MyPrimaryContainer}" />
    </Style>

    <Style Selector="Button.connect">
        <Setter Property="Background" Value="{DynamicResource MyPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnPrimary}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.tonal">
        <Setter Property="Background" Value="{DynamicResource MyNavSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipPurpleText}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button.outline">
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="{DynamicResource MySearch}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="40,8,72,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="RadioButton.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource MySurfaceDim}" />
    </Style>

    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Background" Value="{DynamicResource MyNavSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipPurpleText}" />
    </Style>

    <Style Selector="TextBlock.nav-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource MyKbd}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="TextBlock.kbd">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="Border.badge-protocol">
        <Setter Property="Background" Value="{DynamicResource MyChipPurple}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="Border.badge-delay">
        <Setter Property="Background" Value="{DynamicResource MyChipGreen}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="Border.version-chip">
        <Setter Property="Background" Value="{DynamicResource MyNavSelected}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="ListBox.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.flat ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MaxHeight" Value="44" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
    </Style>

    <Style Selector="ListBox.chips ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource MyNavSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipPurpleText}" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource MyCardMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
    </Style>

    <Style Selector="Button.chip-proxy">
        <Setter Property="Background" Value="{DynamicResource MyChipPurple}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipPurpleText}" />
    </Style>

    <Style Selector="Button.chip-proxy.on">
        <Setter Property="Background" Value="{DynamicResource MyChipPurpleText}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnPrimary}" />
    </Style>

    <Style Selector="Button.chip-direct">
        <Setter Property="Background" Value="{DynamicResource MyChipGreen}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipGreenText}" />
    </Style>

    <Style Selector="Button.chip-direct.on">
        <Setter Property="Background" Value="{DynamicResource MyPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnPrimary}" />
    </Style>

    <Style Selector="Button.chip-block">
        <Setter Property="Background" Value="{DynamicResource MyChipRed}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipRedText}" />
    </Style>

    <Style Selector="Button.chip-block.on">
        <Setter Property="Background" Value="{DynamicResource MyChipRedText}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnPrimary}" />
    </Style>

    <Style Selector="ToggleButton.segment">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurfaceVariant}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ToggleButton.segment:checked">
        <Setter Property="Background" Value="{DynamicResource MyNavSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource MyChipPurpleText}" />
    </Style>

    <Style Selector="Border.segment-track">
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource MyOutline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="RadioButton.mode">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.mode:checked">
        <Setter Property="Background" Value="{DynamicResource MyPrimaryContainer}" />
    </Style>

    <Style Selector="Button.settings-row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource MyCard}" />
        <Setter Property="Foreground" Value="{DynamicResource MyOnSurface}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</Styles>
