<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="color.bg.canvas" Color="#F3F1EB" />
            <SolidColorBrush x:Key="color.bg.surface" Color="#EDEAE3" />
            <SolidColorBrush x:Key="color.bg.elevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="color.text.primary" Color="#1C1B19" />
            <SolidColorBrush x:Key="color.text.secondary" Color="#5C574F" />
            <SolidColorBrush x:Key="color.text.tertiary" Color="#8A8478" />
            <SolidColorBrush x:Key="color.accent" Color="#C4643C" />
            <SolidColorBrush x:Key="color.border.subtle" Color="#E0DBD2" />
            <SolidColorBrush x:Key="color.bg.selected" Color="#E3DDD2" />
            <SolidColorBrush x:Key="color.bg.inverse" Color="#1C1B19" />
            <SolidColorBrush x:Key="color.fg.inverse" Color="#F3F1EB" />
            <SolidColorBrush x:Key="color.bg.inverse.hover" Color="#2A2927" />
            <SolidColorBrush x:Key="color.bg.surfaceHover" Color="#E6E1D8" />
            <SolidColorBrush x:Key="color.latency.fast" Color="#2F6F4E" />
            <SolidColorBrush x:Key="color.latency.mid" Color="#8A6A1F" />
            <SolidColorBrush x:Key="color.latency.slow" Color="#A13D2D" />

            <SolidColorBrush x:Key="MySurface" Color="#F3F1EB" />
            <SolidColorBrush x:Key="MySurfaceDim" Color="#EDEAE3" />
            <SolidColorBrush x:Key="MyCard" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MyCardMuted" Color="#F6F4EE" />
            <SolidColorBrush x:Key="MyOnSurface" Color="#1C1B19" />
            <SolidColorBrush x:Key="MyOnSurfaceVariant" Color="#5C574F" />
            <SolidColorBrush x:Key="MyOutline" Color="#E0DBD2" />
            <SolidColorBrush x:Key="MyPrimary" Color="#C4643C" />
            <SolidColorBrush x:Key="MyOnPrimary" Color="#FFFBF7" />
            <SolidColorBrush x:Key="MyInk" Color="#2A2824" />
            <SolidColorBrush x:Key="MyOnInk" Color="#F7F4EE" />
            <SolidColorBrush x:Key="MyInkHover" Color="#3A3834" />
            <SolidColorBrush x:Key="MyPrimaryContainer" Color="#F3E7DF" />
            <SolidColorBrush x:Key="MyHover" Color="#EBE6DC" />
            <SolidColorBrush x:Key="MySelected" Color="#E3DDD2" />
            <SolidColorBrush x:Key="MyNavSelected" Color="#E3DDD2" />
            <SolidColorBrush x:Key="MySearch" Color="#FFFcf8" />
            <SolidColorBrush x:Key="MyChipPurple" Color="#F0E6DC" />
            <SolidColorBrush x:Key="MyChipPurpleText" Color="#7A5340" />
            <SolidColorBrush x:Key="MyChipGreen" Color="#E6EDE4" />
            <SolidColorBrush x:Key="MyChipGreenText" Color="#3F5C45" />
            <SolidColorBrush x:Key="MyChipRed" Color="#F6E6E2" />
            <SolidColorBrush x:Key="MyChipRedText" Color="#9C4036" />
            <SolidColorBrush x:Key="MyRingTrack" Color="#E0DBD2" />
            <SolidColorBrush x:Key="MyKbd" Color="#EFEBE3" />
            <SolidColorBrush x:Key="MyShadow" Color="#12000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="color.bg.canvas" Color="#1C1B19" />
            <SolidColorBrush x:Key="color.bg.surface" Color="#262522" />
            <SolidColorBrush x:Key="color.bg.elevated" Color="#2F2D29" />
            <SolidColorBrush x:Key="color.text.primary" Color="#F3F1EB" />
            <SolidColorBrush x:Key="color.text.secondary" Color="#B8B2A6" />
            <SolidColorBrush x:Key="color.text.tertiary" Color="#8A8478" />
            <SolidColorBrush x:Key="color.accent" Color="#D47852" />
            <SolidColorBrush x:Key="color.border.subtle" Color="#3A3732" />
            <SolidColorBrush x:Key="color.bg.selected" Color="#32302C" />
            <SolidColorBrush x:Key="color.bg.inverse" Color="#F3F1EB" />
            <SolidColorBrush x:Key="color.fg.inverse" Color="#1C1B19" />
            <SolidColorBrush x:Key="color.bg.inverse.hover" Color="#E4E2DD" />
            <SolidColorBrush x:Key="color.bg.surfaceHover" Color="#2E2C28" />
            <SolidColorBrush x:Key="color.latency.fast" Color="#5CB88A" />
            <SolidColorBrush x:Key="color.latency.mid" Color="#D4A84B" />
            <SolidColorBrush x:Key="color.latency.slow" Color="#E07A6A" />

            <SolidColorBrush x:Key="MySurface" Color="#1C1B19" />
            <SolidColorBrush x:Key="MySurfaceDim" Color="#262522" />
            <SolidColorBrush x:Key="MyCard" Color="#2F2D29" />
