            <SolidColorBrush x:Key="MyOnSurfaceVariant" Color="#B8B2A6" />
            <SolidColorBrush x:Key="MyOutline" Color="#3A3732" />
            <SolidColorBrush x:Key="MyPrimary" Color="#D47852" />
            <SolidColorBrush x:Key="MyOnPrimary" Color="#1C1B19" />
            <SolidColorBrush x:Key="MyInk" Color="#F3F1EB" />
            <SolidColorBrush x:Key="MyOnInk" Color="#1C1B19" />
            <SolidColorBrush x:Key="MyInkHover" Color="#E4E0D6" />
            <SolidColorBrush x:Key="MyPrimaryContainer" Color="#3A2E28" />
            <SolidColorBrush x:Key="MyHover" Color="#2A2826" />
            <SolidColorBrush x:Key="MySelected" Color="#302D29" />
            <SolidColorBrush x:Key="MyNavSelected" Color="#302D29" />
            <SolidColorBrush x:Key="MySearch" Color="#2A2825" />
            <SolidColorBrush x:Key="MyChipPurple" Color="#3A322C" />
            <SolidColorBrush x:Key="MyChipPurpleText" Color="#E7C4B0" />
            <SolidColorBrush x:Key="MyChipGreen" Color="#2A332C" />
            <SolidColorBrush x:Key="MyChipGreenText" Color="#C9D7C4" />
            <SolidColorBrush x:Key="MyChipRed" Color="#3A2826" />
            <SolidColorBrush x:Key="MyChipRedText" Color="#F0B8B0" />
            <SolidColorBrush x:Key="MyRingTrack" Color="#3A3732" />
            <SolidColorBrush x:Key="MyKbd" Color="#33312C" />
            <SolidColorBrush x:Key="MyShadow" Color="#66000000" />
            <SolidColorBrush x:Key="MyCardMuted" Color="#201F1C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="radius.sm">6</CornerRadius>
    <CornerRadius x:Key="radius.md">10</CornerRadius>
    <CornerRadius x:Key="radius.lg">14</CornerRadius>
    <x:Double x:Key="sidebar.width">228</x:Double>
    <x:Double x:Key="titlebar.height">36</x:Double>
    <x:Double x:Key="spacing.4">4</x:Double>
    <x:Double x:Key="spacing.8">8</x:Double>
    <x:Double x:Key="spacing.12">12</x:Double>
    <x:Double x:Key="spacing.16">16</x:Double>
    <x:Double x:Key="spacing.24">24</x:Double>
    <x:Double x:Key="spacing.32">32</x:Double>
</ResourceDictionary>
