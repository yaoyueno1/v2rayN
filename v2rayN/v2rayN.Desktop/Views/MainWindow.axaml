<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="1280"
    Height="840"
    MinWidth="1100"
    MinHeight="640"
    Background="{DynamicResource color.bg.canvas}"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="{StaticResource titlebar.height}"
    WindowDecorations="Full"
    WindowDecorationsTheme="{StaticResource PaperWindowDecorations}"
    x:DataType="vms:MainWindowViewModel"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid
            Margin="{Binding WindowDecorationMargin, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="{DynamicResource color.bg.canvas}"
            RowDefinitions="Auto,*">
            <Border Padding="16,8,16,6" Background="{DynamicResource color.bg.canvas}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="wordmark"
                            Text="v2rayN" />
                        <Border Classes="version-chip" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="txtVersion"
                                Text="0.0.0" />
                        </Border>
                    </StackPanel>

                    <Button
                        x:Name="btnNewUpdate"
                        Grid.Column="1"
                        Classes="tonal"
                        Content="{x:Static resx:ResUI.menuNewUpdate}"
                        IsVisible="False"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource color.bg.surface}">
                    <DockPanel>
                        <StackPanel Margin="12,12,12,8" DockPanel.Dock="Bottom" Spacing="8">
                            <Button
                                x:Name="btnConnect"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="connect">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource IconPlug}"
                                        Foreground="{DynamicResource MyOnInk}" />
                                    <TextBlock Text="{x:Static shell:ShellStrings.Connect}" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnDefinitions="*,*,*">
                                <Button
                                    x:Name="btnTheme"
                                    HorizontalAlignment="Center"
                                    Classes="footer-icon"
                                    ToolTip.Tip="{x:Static resx:ResUI.TbSettingsTheme}">
                                    <PathIcon Width="16" Height="16" Data="{StaticResource IconMoon}" />
                                </Button>
                                <Button
                                    x:Name="menuReload"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Classes="footer-icon"
                                    ToolTip.Tip="{x:Static resx:ResUI.menuReload}">
                                    <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconRefresh}" />
                                </Button>
                                <Button
                                    x:Name="menuClose"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Classes="footer-icon"
                                    ToolTip.Tip="{x:Static resx:ResUI.menuExit}">
                                    <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconClose}" />
                                </Button>
                            </Grid>
                            <Button x:Name="menuPromotion" IsVisible="False" />
                        </StackPanel>
                        <Border Margin="12,0,12,0" DockPanel.Dock="Bottom">
                            <views:ConnectionStatusCard x:Name="connectionCard" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,4,4,0">
                                <RadioButton
                                    x:Name="navHome"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    IsChecked="True"
                                    Tag="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconHome}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavHome}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navSubs"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconSub}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavSubscriptions}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navProfiles"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconConfig}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavProfiles}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navRouting"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconRoute}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavRouting}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navSettings"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconSettings}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavSettings}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navHelp"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource IconInfo}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavHelp}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="0,0,8,8"
                    Background="{DynamicResource color.bg.canvas}"
                    BorderThickness="0">
                <Grid>
                    <Grid x:Name="pageServers" Margin="4,4,4,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border
                                x:Name="configActions"
                                Width="300"
                                Margin="0,4,8,4"
                                Padding="0,0,12,0"
                                Classes="soft-pane"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                IsVisible="False">
                                <DockPanel>
                                    <TextBlock
                                        Classes="pane-label"
                                        DockPanel.Dock="Top"
                                        Text="{x:Static shell:ShellStrings.AddProfileTitle}" />
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Button x:Name="menuAddServerViaClipboard" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                                            <Button x:Name="menuAddServerViaScan" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaScan}" />
                                            <Button x:Name="menuAddServerViaImage" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                            <Button x:Name="menuAddCustomServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddCustomServer}" />
                                            <Button x:Name="menuAddPolicyGroupServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                            <Button x:Name="menuAddProxyChainServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                            <Button x:Name="menuAddCustomOutboundServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                            <Button x:Name="menuAddVmessServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddVmessServer}" />
                                            <Button x:Name="menuAddVlessServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddVlessServer}" />
                                            <Button x:Name="menuAddShadowsocksServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                            <Button x:Name="menuAddTrojanServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                            <Button x:Name="menuAddHysteria2Server" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                            <Button x:Name="menuAddWireguardServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                            <Button x:Name="menuAddMasqueServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                            <Button x:Name="menuAddSocksServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddSocksServer}" />
                                            <Button x:Name="menuAddHttpServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddHttpServer}" />
                                            <Button x:Name="menuAddTuicServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddTuicServer}" />
                                            <Button x:Name="menuAddAnytlsServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                            <Button x:Name="menuAddNaiveServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <ContentControl x:Name="profilesHost" Grid.Column="1" />
                        </Grid>
                    </Grid>
                    <Grid
                        x:Name="pageSubs"
                        Margin="20,16,20,16"
                        IsVisible="False"
                        RowDefinitions="Auto,*">
                        <WrapPanel Margin="0,0,0,12">
                            <Button
                                x:Name="menuSubSetting"
                                Margin="0,0,8,8"
                                Classes="tonal"
                                Content="{x:Static resx:ResUI.menuSubSetting}" />
                            <Button
                                x:Name="menuSubUpdate"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubUpdate}" />
                            <Button
                                x:Name="menuSubUpdateViaProxy"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                            <Button
                                x:Name="menuSubGroupUpdate"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                            <Button
                                x:Name="menuSubGroupUpdateViaProxy"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                        </WrapPanel>
                        <views:SubscriptionPage x:Name="subscriptionPage" Grid.Row="1" />
                    </Grid>
                    <Grid
                        x:Name="pageRouting"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <views:RoutingPage x:Name="routingPage" />
                    </Grid>
                    <Grid
                        x:Name="pageSettings"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <views:SettingsPage x:Name="settingsPage" />
                    </Grid>
                    <Grid
                        x:Name="pageHelp"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Spacing="16">
                                <TextBlock
                                    Classes="page-title"
                                    Text="{x:Static shell:ShellStrings.HelpTitle}" />
                                <UniformGrid x:Name="helpLinks" Columns="2">
                                    <Button
                                        x:Name="menuCheckUpdate"
                                        Classes="settings-row"
                                        Content="{x:Static resx:ResUI.menuCheckUpdate}" />
                                </UniformGrid>
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Classes="section-title"
                                        Text="{x:Static shell:ShellStrings.AboutTitle}" />
                                    <TextBlock
                                        x:Name="txtAboutVersion"
                                        Foreground="{DynamicResource MyOnSurfaceVariant}" />
                                    <TextBlock
                                        Text="{x:Static shell:ShellStrings.AboutBody}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,12,0,8"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                                    <Image
                                        Width="88"
                                        Height="88"
                                        HorizontalAlignment="Center"
                                        Source="avares://v2rayN/Assets/ForkMark.png" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Classes="section-title"
                                        Text="v2rayN" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource MyOnSurfaceVariant}"
                                        Text="{x:Static shell:ShellStrings.FontCredit}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid
                        x:Name="pageDetails"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <DockPanel>
                            <StackPanel
                                Margin="0,0,0,12"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    Classes="outline"
                                    Click="DetailsBack_Click"
                                    Content="{x:Static shell:ShellStrings.Back}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="section-title"
                                    Text="{x:Static shell:ShellStrings.DetailsTitle}" />
                            </StackPanel>
                            <TabControl x:Name="tabMain">
                                <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                                <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                            </TabControl>
                        </DockPanel>
                    </Grid>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </dialogHost:DialogHost>
</Window>
