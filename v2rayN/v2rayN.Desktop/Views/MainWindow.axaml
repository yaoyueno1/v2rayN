<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="1280"
    Height="840"
    MinWidth="1100"
    MinHeight="640"
    x:DataType="vms:MainWindowViewModel"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid RowDefinitions="Auto,*">
            <Border Padding="20,16,20,12" Background="{DynamicResource MySurface}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="wordmark"
                            Text="v2rayN" />
                        <Border Classes="version-chip" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="txtVersion"
                                Text="0.0.0" />
                        </Border>
                    </StackPanel>

                    <TextBox
                        x:Name="txtSearch"
                        Grid.Column="1"
                        MaxWidth="560"
                        Margin="24,0"
                        Classes="search"
                        PlaceholderText="{x:Static shell:ShellStrings.SearchNodes}"
                        UseFloatingPlaceholder="False">
                        <TextBox.InnerLeftContent>
                            <PathIcon
                                Width="18"
                                Height="18"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Data="{StaticResource IconSearch}"
                                Foreground="{DynamicResource MyOnSurfaceVariant}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Border
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Classes="kbd"
                                IsHitTestVisible="False">
                                <TextBlock Classes="kbd" Text="{x:Static shell:ShellStrings.SearchShortcut}" />
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <Button
                        x:Name="btnNewUpdate"
                        Grid.Column="2"
                        Classes="tonal"
                        Content="{x:Static resx:ResUI.menuNewUpdate}"
                        IsVisible="False"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="248,*">
                <Border Background="Transparent">
                    <DockPanel>
                        <StackPanel Margin="0,4,0,8" DockPanel.Dock="Bottom">
                            <TextBlock Classes="nav-section" Text="{x:Static shell:ShellStrings.SectionActions}" />
                            <Button x:Name="menuReload" Classes="drawer-action">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Width="22" Height="22" Data="{StaticResource SemiIconRefresh}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuReload}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="menuPromotion" Classes="drawer-action">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Width="22" Height="22" Data="{StaticResource IconAdd}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuPromotion}" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="12,8,12,4" ColumnDefinitions="Auto,*">
                                <Button
                                    x:Name="btnTheme"
                                    Classes="theme-toggle">
                                    <PathIcon Width="18" Height="18" Data="{StaticResource IconMoon}" />
                                </Button>
                                <Button
                                    x:Name="btnConnect"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Classes="connect">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource IconPlug}"
                                            Foreground="{DynamicResource MyOnInk}" />
                                        <TextBlock Text="{x:Static shell:ShellStrings.Connect}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button x:Name="menuClose" Classes="drawer-action">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Width="22" Height="22" Data="{StaticResource SemiIconClose}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuExit}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,0,0">
                                <RadioButton
                                    x:Name="navHome"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    IsChecked="True"
                                    Tag="0">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconHome}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavHome}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navSubs"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="2">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconSub}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavSubscriptions}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navProfiles"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="1">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconConfig}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavProfiles}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navRouting"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="3">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconRoute}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavRouting}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navSettings"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="4">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconSettings}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavSettings}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="navHelp"
                                    Classes="nav"
                                    GroupName="shellNav"
                                    Tag="5">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="22" Height="22" Data="{StaticResource IconInfo}" />
                                        <TextBlock Classes="nav-label" Text="{x:Static shell:ShellStrings.NavHelp}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="0,0,12,12"
                    Background="{DynamicResource MySurface}"
                    BorderThickness="0">
                <Grid>
                    <Grid x:Name="pageServers" Margin="12,12,384,12">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border
                                x:Name="configActions"
                                Width="300"
                                Margin="0,4,8,4"
                                Padding="0,0,12,0"
                                Classes="soft-pane"
                                BorderBrush="{DynamicResource MyOutline}"
                                BorderThickness="0,0,1,0"
                                IsVisible="False">
                                <DockPanel>
                                    <TextBlock
                                        Classes="pane-label"
                                        DockPanel.Dock="Top"
                                        Text="{x:Static shell:ShellStrings.AddProfileTitle}" />
                                    <ScrollViewer
                                        Classes="soft"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <x:Double x:Key="ScrollBarSize">6</x:Double>
                                            <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="#665C574E" />
                                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                                        </ScrollViewer.Resources>
                                        <StackPanel>
                                            <Button x:Name="menuAddServerViaClipboard" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                                            <Button x:Name="menuAddServerViaScan" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaScan}" />
                                            <Button x:Name="menuAddServerViaImage" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                            <Button x:Name="menuAddCustomServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddCustomServer}" />
                                            <Button x:Name="menuAddPolicyGroupServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                            <Button x:Name="menuAddProxyChainServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                            <Button x:Name="menuAddCustomOutboundServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                            <Button x:Name="menuAddVmessServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddVmessServer}" />
                                            <Button x:Name="menuAddVlessServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddVlessServer}" />
                                            <Button x:Name="menuAddShadowsocksServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                            <Button x:Name="menuAddTrojanServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                            <Button x:Name="menuAddHysteria2Server" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                            <Button x:Name="menuAddWireguardServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                            <Button x:Name="menuAddMasqueServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                            <Button x:Name="menuAddSocksServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddSocksServer}" />
                                            <Button x:Name="menuAddHttpServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddHttpServer}" />
                                            <Button x:Name="menuAddTuicServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddTuicServer}" />
                                            <Button x:Name="menuAddAnytlsServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                            <Button x:Name="menuAddNaiveServer" Classes="soft-item" Content="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <ContentControl x:Name="profilesHost" Grid.Column="1" />
                        </Grid>
                    </Grid>
                    <Grid
                        x:Name="pageSubs"
                        Margin="20,16,20,16"
                        IsVisible="False"
                        RowDefinitions="Auto,*">
                        <WrapPanel Margin="0,0,0,12">
                            <Button
                                x:Name="menuSubSetting"
                                Margin="0,0,8,8"
                                Classes="tonal"
                                Content="{x:Static resx:ResUI.menuSubSetting}" />
                            <Button
                                x:Name="menuSubUpdate"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubUpdate}" />
                            <Button
                                x:Name="menuSubUpdateViaProxy"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                            <Button
                                x:Name="menuSubGroupUpdate"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                            <Button
                                x:Name="menuSubGroupUpdateViaProxy"
                                Margin="0,0,8,8"
                                Classes="outline"
                                Content="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                        </WrapPanel>
                        <views:SubscriptionPage x:Name="subscriptionPage" Grid.Row="1" />
                    </Grid>
                    <Grid
                        x:Name="pageRouting"
                        Margin="20,16,384,12"
                        IsVisible="False">
                        <views:RoutingPage x:Name="routingPage" />
                    </Grid>
                    <Grid
                        x:Name="pageSettings"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <views:SettingsPage x:Name="settingsPage" />
                    </Grid>
                    <Grid
                        x:Name="pageHelp"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="12">
                                <TextBlock
                                    Classes="page-title"
                                    Text="{x:Static shell:ShellStrings.HelpTitle}" />
                                <Button
                                    x:Name="menuCheckUpdate"
                                    Classes="settings-row"
                                    Content="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <StackPanel x:Name="helpLinks" Spacing="4" />
                                <Border Classes="hairline" />
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Classes="section-title"
                                        Text="{x:Static shell:ShellStrings.AboutTitle}" />
                                    <TextBlock
                                        x:Name="txtAboutVersion"
                                        Foreground="{DynamicResource MyOnSurfaceVariant}" />
                                    <TextBlock
                                        Text="{x:Static shell:ShellStrings.AboutBody}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid
                        x:Name="pageDetails"
                        Margin="20,16,20,16"
                        IsVisible="False">
                        <DockPanel>
                            <StackPanel
                                Margin="0,0,0,12"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    Classes="outline"
                                    Click="DetailsBack_Click"
                                    Content="{x:Static shell:ShellStrings.Back}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="section-title"
                                    Text="{x:Static shell:ShellStrings.DetailsTitle}" />
                            </StackPanel>
                            <TabControl x:Name="tabMain">
                                <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                                <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                            </TabControl>
                        </DockPanel>
                    </Grid>

                    <Border
                        x:Name="connectionHost"
                        Width="360"
                        Margin="8,8,8,8"
                        Padding="16,4,8,8"
                        HorizontalAlignment="Right"
                        BorderBrush="{DynamicResource MyOutline}"
                        BorderThickness="1,0,0,0">
                        <views:ConnectionStatusCard x:Name="connectionCard" />
                    </Border>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </dialogHost:DialogHost>
</Window>
