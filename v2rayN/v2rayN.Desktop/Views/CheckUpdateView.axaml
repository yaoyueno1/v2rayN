<UserControl
    x:Class="v2rayN.Desktop.Views.CheckUpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="460"
    d:DesignWidth="500"
    x:DataType="vms:CheckUpdateViewModel"
    Design.DataContext="{x:Static dd:DesignData.CheckUpdate}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:UpdateStatusConverter x:Key="UpdateStatus" />
    </UserControl.Resources>

    <Border Classes="paper-modal">
        <DockPanel>
            <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto" DockPanel.Dock="Top">
                <TextBlock Classes="update-title" Text="{x:Static resx:ResUI.menuCheckUpdate}" />
                <Button
                    x:Name="btnClose"
                    Grid.Column="1"
                    Classes="dialog-close">
                    <PathIcon
                        Width="16"
                        Height="16"
                        Data="{StaticResource SemiIconClose}" />
                </Button>
            </Grid>
            <Grid
                Margin="0,16,0,0"
                ColumnDefinitions="*,Auto"
                DockPanel.Dock="Bottom">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="update-proxy"
                        Text="{x:Static resx:ResUI.TbSettingsEnableUpdateViaProxy}" />
                    <ToggleButton
                        x:Name="togEnableUpdateViaProxy"
                        VerticalAlignment="Center"
                        Classes="rule-switch" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="btnCheckOnly"
                        Classes="update-secondary"
                        Content="{x:Static resx:ResUI.menuCheckOnly}" />
                    <Button
                        x:Name="btnCheckUpdate"
                        Classes="update-primary"
                        Content="{x:Static resx:ResUI.menuCheckAndUpdate}" />
                </StackPanel>
            </Grid>

            <ListBox
                x:Name="lstCheckUpdates"
                Classes="update-rows"
                ItemsSource="{Binding CheckUpdateModels}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="Single">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                            <ToggleButton
                                VerticalAlignment="Center"
                                Classes="rule-switch"
                                IsChecked="{Binding IsSelected}" />
                            <Grid
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"
                                RowDefinitions="Auto,Auto">
                                <TextBlock Classes="update-name" Text="{Binding CoreTypeForStorage}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="update-status new"
                                    IsVisible="{Binding Remarks, Converter={StaticResource UpdateStatus}, ConverterParameter=new}"
                                    Text="{Binding Remarks, Converter={StaticResource UpdateStatus}}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="update-status latest"
                                    IsVisible="{Binding Remarks, Converter={StaticResource UpdateStatus}, ConverterParameter=latest}"
                                    Text="{Binding Remarks, Converter={StaticResource UpdateStatus}}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="update-status checking"
                                    IsVisible="{Binding Remarks, Converter={StaticResource UpdateStatus}, ConverterParameter=checking}"
                                    Text="{Binding Remarks, Converter={StaticResource UpdateStatus}}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="update-status"
                                    IsVisible="{Binding Remarks, Converter={StaticResource UpdateStatus}, ConverterParameter=plain}"
                                    Text="{Binding Remarks, Converter={StaticResource UpdateStatus}}" />
                            </Grid>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowCheckPreRelease}"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="update-pre"
                                    Text="{x:Static shell:ShellStrings.PreRelease}" />
                                <ToggleButton
                                    VerticalAlignment="Center"
                                    Classes="rule-switch compact"
                                    IsChecked="{Binding IsCheckPreRelease}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
