<UserControl
    x:Class="v2rayN.Desktop.Views.ConnectionStatusCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border Classes="surface-card" Padding="2,0,2,0">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="40,*">
                <Viewbox Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Width="132" Height="132">
                        <Ellipse
                            Width="112"
                            Height="112"
                            Stroke="{DynamicResource MyRingTrack}"
                            StrokeThickness="10" />
                        <Path
                            x:Name="ringArc"
                            Width="112"
                            Height="112"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M56,8 A48,48 0 1 1 22,86"
                            Stroke="{DynamicResource MyPrimary}"
                            StrokeLineCap="Round"
                            StrokeThickness="10" />
                        <Border
                            x:Name="statusBadge"
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MyInk}"
                            CornerRadius="32">
                            <PathIcon
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconCheck}"
                                Foreground="{DynamicResource MyOnInk}" />
                        </Border>
                    </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="statusDot"
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource MyPrimary}" />
                        <TextBlock
                            x:Name="txtState"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Medium"
                            LineHeight="18"
                            Text="{x:Static shell:ShellStrings.Disconnected}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="txtSince"
                        Margin="0,1,0,0"
                        FontSize="11"
                        LineHeight="14"
                        Foreground="{DynamicResource MyOnSurfaceVariant}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="txtServer"
                        FontSize="11"
                        LineHeight="14"
                        Foreground="{DynamicResource MyOnSurfaceVariant}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconUpload}"
                        Foreground="{DynamicResource MyPrimary}" />
                    <TextBlock
                        x:Name="txtUp"
                        VerticalAlignment="Center"
                        FontSize="12"
                        LineHeight="16"
                        Text="0 B/s" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconDownload}"
                        Foreground="{DynamicResource MyChipPurpleText}" />
                    <TextBlock
                        x:Name="txtDown"
                        VerticalAlignment="Center"
                        FontSize="12"
                        LineHeight="16"
                        Text="0 B/s" />
                </StackPanel>
                <Polyline
                    x:Name="sparkUp"
                    Width="0"
                    Height="0"
                    IsVisible="False"
                    Stroke="{DynamicResource MyPrimary}" />
                <Polyline
                    x:Name="sparkDown"
                    Width="0"
                    Height="0"
                    IsVisible="False"
                    Stroke="{DynamicResource MyChipPurpleText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                    x:Name="modeSystem"
                    Classes="mode segment"
                    GroupName="outboundMode"
                    Content="{x:Static shell:ShellStrings.SystemProxy}" />
                <RadioButton
                    x:Name="modeTun"
                    Classes="mode segment"
                    GroupName="outboundMode"
                    Content="TUN" />
                <RadioButton
                    x:Name="modePac"
                    Classes="mode segment"
                    GroupName="outboundMode"
                    Content="PAC" />
            </StackPanel>

            <Button
                x:Name="btnDetails"
                HorizontalAlignment="Left"
                MinHeight="26"
                Padding="2,2"
                Classes="ghost"
                Content="{x:Static shell:ShellStrings.ViewDetails}"
                FontSize="12" />
        </StackPanel>
    </Border>
</UserControl>
