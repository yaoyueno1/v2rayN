<UserControl
    x:Class="v2rayN.Desktop.Views.ConnectionStatusCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border Classes="surface-card" Padding="4,2,4,0">
        <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    x:Name="statusDot"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource MyPrimary}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource MyOnSurfaceVariant}"
                    Text="{x:Static shell:ShellStrings.ConnectionStatus}" />
            </StackPanel>

            <Grid Margin="0,6,0,0" ColumnDefinitions="64,*">
                <Viewbox Width="44" Height="44" HorizontalAlignment="Left">
                    <Grid Width="132" Height="132">
                        <Ellipse
                            Width="112"
                            Height="112"
                            Stroke="{DynamicResource MyRingTrack}"
                            StrokeThickness="10" />
                        <Path
                            x:Name="ringArc"
                            Width="112"
                            Height="112"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M56,8 A48,48 0 1 1 22,86"
                            Stroke="{DynamicResource MyPrimary}"
                            StrokeLineCap="Round"
                            StrokeThickness="10" />
                        <Border
                            x:Name="statusBadge"
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MyInk}"
                            CornerRadius="32">
                            <PathIcon
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconCheck}"
                                Foreground="{DynamicResource MyOnInk}" />
                        </Border>
                    </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="txtState"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="{x:Static shell:ShellStrings.Disconnected}" />
                    <TextBlock
                        x:Name="txtSince"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource MyOnSurfaceVariant}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="txtServer"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource MyOnSurfaceVariant}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,8,0,0" ColumnDefinitions="*,*">
                <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon
                            Width="12"
                            Height="12"
                            Data="{StaticResource IconUpload}"
                            Foreground="{DynamicResource MyPrimary}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource MyOnSurfaceVariant}"
                            Text="{x:Static shell:ShellStrings.Upload}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="txtUp"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="0 B/s" />
                    <Polyline
                        x:Name="sparkUp"
                        Height="0"
                        IsVisible="False"
                        Stroke="{DynamicResource MyPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon
                            Width="12"
                            Height="12"
                            Data="{StaticResource IconDownload}"
                            Foreground="{DynamicResource MyChipPurpleText}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource MyOnSurfaceVariant}"
                            Text="{x:Static shell:ShellStrings.Download}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="txtDown"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="0 B/s" />
                    <Polyline
                        x:Name="sparkDown"
                        Height="0"
                        IsVisible="False"
                        Stroke="{DynamicResource MyChipPurpleText}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,8,0,2"
                FontSize="12"
                Foreground="{DynamicResource MyOnSurfaceVariant}"
                Text="{x:Static shell:ShellStrings.OutboundMode}" />

            <StackPanel Spacing="1">
                <RadioButton
                    x:Name="modeSystem"
                    Classes="mode compact"
                    GroupName="outboundMode">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource MyPrimary}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static shell:ShellStrings.SystemProxy}" />
                        <PathIcon
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconMonitor}"
                            Foreground="{DynamicResource MyOnSurfaceVariant}" />
                    </Grid>
                </RadioButton>
                <RadioButton
                    x:Name="modeTun"
                    Classes="mode compact"
                    GroupName="outboundMode">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource MyOutline}"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static shell:ShellStrings.Tun}" />
                        <PathIcon
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconShield}"
                            Foreground="{DynamicResource MyOnSurfaceVariant}" />
                    </Grid>
                </RadioButton>
                <RadioButton
                    x:Name="modePac"
                    Classes="mode compact"
                    GroupName="outboundMode">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource MyOutline}"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static shell:ShellStrings.Pac}" />
                        <PathIcon
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconDoc}"
                            Foreground="{DynamicResource MyOnSurfaceVariant}" />
                    </Grid>
                </RadioButton>
            </StackPanel>

            <Button
                x:Name="btnDetails"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                MinHeight="32"
                Padding="4,4"
                Classes="outline"
                Content="{x:Static shell:ShellStrings.ViewDetails}" />
        </StackPanel>
    </Border>
</UserControl>
