<UserControl
    x:Class="v2rayN.Desktop.Views.ConnectionStatusCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:v2rayN.Desktop.Common"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border Classes="surface-card" Padding="0">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="16,*">
                <Ellipse
                    x:Name="statusDot"
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="Transparent"
                    StrokeThickness="2" />
                <Panel IsHitTestVisible="False" IsVisible="False">
                    <Path
                        x:Name="ringArc"
                        Data="M56,8 A48,48 0 1 1 22,86"
                        Stroke="{DynamicResource color.accent}"
                        StrokeThickness="10" />
                    <Border
                        x:Name="statusBadge"
                        Width="10"
                        Height="10"
                        Background="Transparent" />
                </Panel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="txtState"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="{DynamicResource color.text.primary}"
                        LineHeight="18"
                        Text="{x:Static shell:ShellStrings.Disconnected}" />
                    <TextBlock
                        x:Name="txtSince"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        Foreground="{DynamicResource color.text.secondary}"
                        LineHeight="16"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="txtServer"
                FontSize="12"
                FontWeight="Normal"
                Foreground="{DynamicResource color.text.secondary}"
                IsVisible="False"
                LineHeight="16"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconUpload}"
                        Foreground="{DynamicResource color.text.tertiary}" />
                    <TextBlock
                        x:Name="txtUp"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        LineHeight="16"
                        Text="0 B/s" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconDownload}"
                        Foreground="{DynamicResource color.text.tertiary}" />
                    <TextBlock
                        x:Name="txtDown"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        LineHeight="16"
                        Text="0 B/s" />
                </StackPanel>
                <Polyline
                    x:Name="sparkUp"
                    Width="0"
                    Height="0"
                    IsVisible="False"
                    Stroke="{DynamicResource color.accent}" />
                <Polyline
                    x:Name="sparkDown"
                    Width="0"
                    Height="0"
                    IsVisible="False"
                    Stroke="{DynamicResource color.text.secondary}" />
            </StackPanel>

            <Button
                x:Name="btnDetails"
                Classes="text-link"
                Content="{x:Static shell:ShellStrings.ViewDetails}" />

            <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton
                    x:Name="modeSystem"
                    Classes="mode segment"
                    Content="{x:Static shell:ShellStrings.SystemProxy}"
                    GroupName="outboundMode" />
                <RadioButton
                    x:Name="modeTun"
                    Classes="mode segment"
                    Content="TUN"
                    GroupName="outboundMode" />
                <RadioButton
                    x:Name="modePac"
                    Classes="mode segment"
                    Content="PAC"
                    GroupName="outboundMode" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
